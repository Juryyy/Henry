# Vzor konfigurace. Zkopíruj na `.env` (do gitu NEPATŘÍ) a vyplň klíče.
# Vygeneruješ je příkazem:  cd server && npm run keys
#
# Všechno ostatní má rozumnou výchozí hodnotu – tenhle soubor se dá
# zkopírovat a doplnit jen ty tři klíče nahoře.

# Klíče pro Web Push. Vygeneruj JEDNOU a pak už neměň:
# přegenerování zneplatní všechny existující odběry notifikací.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Push služby vyžadují kontakt pro případ problému.
VAPID_SUBJECT=mailto:tvuj@email.cz

# Časové pásmo, ve kterém se vyhodnocují časy připomínek.
TZ_NAME=Europe/Prague

PORT=8080
HOST=0.0.0.0

# Cookie se sezením chodí jen po HTTPS – a bez HTTPS stejně nefunguje
# service worker, push ani Face ID. Na `off` to přepni jen při ladění
# na localhostu.
SECURE_COOKIES=on

# SCHEDULER=off vypne plánovač (hodí se při ladění).

# ─────────────────────────────────────────────────────────────
# Jen pro běh MIMO Docker (`npm run dev`). V kontejneru si obojí
# nastavuje compose sám – kdyby to tu zůstalo odkomentované,
# přebilo by to hodnoty z obrazu a server by appku neservíroval.
# ─────────────────────────────────────────────────────────────
# APP_DIR=../app/dist
# DB_FILE=./data/henry.sqlite
