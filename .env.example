# Vzor konfigurace. Zkopíruj na `.env` (do gitu NEPATŘÍ) a vyplň.
# Klíče vygeneruješ příkazem:  cd server && npm run keys

# Klíče pro Web Push. Vygeneruj JEDNOU a pak už neměň:
# přegenerování zneplatní všechny existující odběry notifikací.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Push služby vyžadují kontakt pro případ problému.
VAPID_SUBJECT=mailto:tvuj@email.cz

# Časové pásmo, ve kterém se vyhodnocují časy připomínek.
TZ_NAME=Europe/Prague

PORT=8080
HOST=0.0.0.0
# Databáze: účty, data i provozní stav. Jeden soubor.
DB_FILE=./data/henry.sqlite

# Odkud se servíruje appka. V Dockeru se nastavuje samo; při vývoji
# ukazuje na build appky. Prázdné = server jede jen jako API.
APP_DIR=../app/dist

# Cookie se sezením chodí jen po HTTPS. Při vývoji na localhostu: off.
SECURE_COOKIES=on

# Odkud smí appka volat API. '*' je pro appku pro jednoho člověka v pohodě,
# API je stejně chráněné tokenem.
CORS_ORIGINS=*

# SCHEDULER=off vypne plánovač (hodí se při ladění).
